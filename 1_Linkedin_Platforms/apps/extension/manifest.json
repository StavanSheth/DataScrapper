{
  "manifest_version": 3,
  "name": "DataScrapper Platform & Lead Scout (:8085)",
  "version": "3.1.0",
  "description": "Dedicated Chrome Extension for 1_Linkedin_Platforms (Port 8085). 1-click Directory extraction (Fresha, Airbnb, Yelp, TripAdvisor), LinkedIn Org capture, and real-time dashboard bridge.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "debugger",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:8085/*",
    "http://localhost:8085/*",
    "ws://127.0.0.1:8085/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DataScrapper Assistant (:8085)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected_bridge.js",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "icon.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
