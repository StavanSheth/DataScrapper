{
  "manifest_version": 3,
  "name": "Mavon Leads Scraper - Chrome Assistant",
  "version": "2.1.0",
  "description": "Premium Chrome assistant for Mavon Leads: 1-click DOM extraction, Google Maps place inspector, Cloudflare email decoding, phone harvesting, and instant sync to Mavon Leads Database.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "debugger",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mavon Leads Scraper Assistant",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected_bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
